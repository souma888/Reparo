{
  "name": "reparo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:api": "tsx --env-file-if-exists=.env.local server/dev.ts",
    "dev": "npm run dev --workspace frontend",
    "build": "tsc -p tsconfig.json && npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "test": "npm run test --workspace frontend"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.165",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  }
}
